{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/espn-proxy/:path*",
      "destination": "/api/espn-proxy?path=:path*"
    },
    {
      "source": "/mlb-proxy/:path*",
      "destination": "/api/mlb-proxy?path=:path*"
    },
    {
      "source": "/members/:username",
      "destination": "/api/preview-member?username=:username"
    },
    {
      "source": "/players/:id",
      "destination": "/api/preview-player?id=:id"
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/team-notifications",
      "schedule": "0 16 * * *"
    }
  ]
}
