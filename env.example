# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key_here

# Sports API Configuration
REACT_APP_SPORTS_API_KEY=your_sports_api_key_here
REACT_APP_SPORTS_API_BASE_URL=https://api.example-sports.com

# Roblox API Configuration
REACT_APP_ROBLOX_API_KEY=your_roblox_api_key_here
REACT_APP_API_URL=http://localhost:3001

# Application Configuration
REACT_APP_ENV=development
REACT_APP_LOG_LEVEL=debug

# Discord webhooks (server-only — set in Vercel dashboard, not needed locally)
# DISCORD_DIGEST_WEBHOOK_URL   — used by api/weekly-digest.js (weekly summary)
# DISCORD_EVENTS_WEBHOOK_URL   — used by api/discord-notify.js (live auto-posts
#                                 for new POTM/accolades/HOF/articles); falls
#                                 back to DISCORD_DIGEST_WEBHOOK_URL if unset

# Vercel Blob
# When connected, Vercel will set `BLOB_READ_WRITE_TOKEN` automatically for
# serverless functions. For local development, copy this file to `.env.local`
# and set `BLOB_READ_WRITE_TOKEN` to your project's read/write token.
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here
